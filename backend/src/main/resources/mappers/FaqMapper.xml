<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.farmday.help.mapper.FaqMapper">

    <resultMap id="FaqResponseMap" type="com.farmday.help.dto.FaqResponseDto">
        <id     property="faqId"        column="FAQ_ID" />
        <result property="categoryId"   column="CATEGORY_ID" />
        <result property="categoryName" column="CATEGORY_NAME" />
        <result property="question"     column="QUESTION" />
        <result property="answer"       column="ANSWER" />
        <result property="viewCount"    column="VIEW_COUNT" />
        <result property="likeCount"    column="LIKE_COUNT" />
        <result property="dislikeCount" column="DISLIKE_COUNT" />
    </resultMap>

    <!-- FAQ 목록 조회 (카테고리/키워드 필터) -->
    <select id="findFaqList" resultMap="FaqResponseMap">
        SELECT
            f.FAQ_ID,
            f.CATEGORY_ID,
            c.NAME AS CATEGORY_NAME,
            f.QUESTION,
            f.ANSWER,
            f.VIEW_COUNT,
            f.LIKE_COUNT,
            f.DISLIKE_COUNT
        FROM FAQ f
        JOIN HELP_CATEGORY c
          ON f.CATEGORY_ID = c.CATEGORY_ID
        WHERE f.IS_VISIBLE = 'Y'
          AND c.IS_ACTIVE = 'Y'
        <if test="categoryId != null">
          AND f.CATEGORY_ID = #{categoryId}
        </if>
        <if test="keyword != null and keyword != ''">
          AND (
            LOWER(f.QUESTION) LIKE '%' || LOWER(#{keyword}) || '%'
            OR LOWER(f.ANSWER) LIKE '%' || LOWER(#{keyword}) || '%'
          )
        </if>
        ORDER BY c.SORT_ORDER, f.FAQ_ID DESC
    </select>

</mapper>